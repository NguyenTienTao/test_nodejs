<div class="mt-4">
    <div class="row row-cols-sm-2 g-sm-3 row-cols-lg-3 g-lg-4">
        {{#each courses}}
            <div>
                <div class="card">
                    <a href="/courses/{{slug}}"><img
                            src="{{image}}"
                            class="card-img-top"
                            alt="{{name}}"
                        /></a>
                    <div class="card-body">
                        <a href="/courses/{{slug}}"><h5
                                class="card-title"
                            >{{name}}</h5></a>
                        <p
                            class="card-text line-clamp"
                            style="--line-clamp: 2"
                        >{{description}}</p>
                        <a href="#" class="btn btn-primary">Mua khóa học</a>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>