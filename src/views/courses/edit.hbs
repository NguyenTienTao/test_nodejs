<div class="mt-4">
    <h3>Đăng ký khóa học</h3>
    {{#with course}}
        <form method="post" action="/courses/{{_id}}?_method=PUT">
            <div class="mb-3">
                <label for="name" class="form-label">Tên khóa học</label>
                <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="name"
                    value="{{name}}"
                />
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Mô tả</label>
                <input
                    type="text"
                    class="form-control"
                    id="description"
                    name="description"
                    value="{{description}}"
                />
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Thumbnail</label>
                <input
                    type="text"
                    class="form-control"
                    id="image"
                    name="image"
                    value="{{image}}"
                />
            </div>
            <div class="mb-3">
                <label for="videoId" class="form-label">VideoId</label>
                <input
                    type="text"
                    class="form-control"
                    id="videoId"
                    name="videoId"
                    value="{{videoId}}"
                />
            </div>
            <div class="mb-3">
                <label for="slug" class="form-label">Slug</label>
                <input
                    type="text"
                    class="form-control"
                    id="slug"
                    name="slug"
                    value="{{slug}}"
                />
            </div>
            <button type="submit" class="btn btn-primary">Cập nhật</button>
        </form>
    {{/with}}
</div>